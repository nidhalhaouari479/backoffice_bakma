# ------------------------------------------------------------------
# Bakma Store — variables d'environnement
# Copier ce fichier en .env.local puis renseigner les valeurs.
# Supabase > Project Settings > API
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# URLs des 3 applications (liens croisés, redirections après inscription)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_VET_URL=http://localhost:3002

# Clé « service_role » (Supabase > Project Settings > API) — SERVEUR UNIQUEMENT, jamais NEXT_PUBLIC_.
# Nécessaire pour créer un compte vétérinaire depuis le back-office (Vétérinaires > Ajouter).
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role
